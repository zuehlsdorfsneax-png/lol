{
  "name": "orbitlabor",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Orbitlabor – interaktive Drei-Körper-Simulation zur Bahnstabilität von Erde, Mond und Sonne (Seminararbeit Astronomie)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "calibrate": "tsx scripts/calibrate.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "exe": "node scripts/build-exe.mjs",
    "mac": "node scripts/build-mac.mjs",
    "apk": "node scripts/build-apk.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "katex": "^0.18.9",
    "preact": "^10.29.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "author": "Seminararbeit Astronomie"
}
