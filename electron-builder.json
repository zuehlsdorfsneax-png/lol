{
  "appId": "de.seminararbeit.orbitlabor",
  "productName": "Orbitlabor",
  "directories": { "output": "release" },
  "files": ["dist/**/*", "!dist/**/*.map", "desktop/main.cjs", "desktop/icon.png", "package.json"],
  "extraMetadata": { "main": "desktop/main.cjs" },
  "asar": true,
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "icon": "desktop/icon.png",
    "signAndEditExecutable": false
  },
  "portable": { "artifactName": "Orbitlabor-${version}-portable.exe" }
}
